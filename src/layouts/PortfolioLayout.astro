---
import "../styles/portfolio.css";
import PortfolioChatbot from '../components/PortfolioChatbot.astro';
import PortfolioMusic from '../components/PortfolioMusic.astro';
import { homeCopy } from '../i18n/home';
import type { Locale } from '../i18n/routes';
interface Props { locale?: Locale; title?: string; description?: string }
const { locale = 'en', title = homeCopy[locale].title, description = homeCopy[locale].description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
<meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <!--
    Social brand marks — provenance and attribution.
    The GitHub, LinkedIn and Instagram glyphs below are the published
    Bootstrap Icons v1.11.3 icons (github.svg, linkedin.svg, instagram.svg),
    retrieved from the package CDN
    (https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/).
    Bootstrap Icons is MIT licensed: Copyright (c) 2019-2024 The Bootstrap
    Authors, https://github.com/twbs/icons/blob/main/LICENSE.
    They are used only as recognizable third-party marks beside their own
    text labels. They are not official publisher assets and this page claims
    no endorsement; the trademarks remain the property of their owners.
  -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    {import.meta.env.PROD && <link rel="modulepreload" href={__THREE_CHUNK__} />}
  </head>
  <body>
    <slot />
    <PortfolioChatbot locale={locale} />
    <PortfolioMusic locale={locale} />
    <script>
      import "../scripts/portfolio-scene.js";
      import "../scripts/cinema-scroll.mjs";
    </script>
  </body>
</html>
