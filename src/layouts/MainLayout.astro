---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { description, title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#110420" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://onecodesite.vercel.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://onecodesite.vercel.app/public/logo.png"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://onecodesite.vercel.app" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content="https://onecodesite.vercel.app/public/logo.png"
    />

    <link rel="stylesheet" href="assets/hugeicons/hugeicons-font.css" />
    <link
      href="https://fonts.cdnfonts.com/css/nevermind-semi-serif"
      rel="stylesheet"
    />
    <style>
      .wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .main {
        flex-grow: 1;
      }
    </style>
  </head>

  <body>
    <div class="container mx-auto wrapper">
      <Header />
      <section class="main">
        <slot />
      </section>
      <Footer />
    </div>
  </body>
</html>
