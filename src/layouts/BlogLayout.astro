---
import BlogChrome from '../components/BlogChrome.astro';
import PortfolioChatbot from '../components/PortfolioChatbot.astro';
import PortfolioMusic from '../components/PortfolioMusic.astro';
import '../styles/portfolio.css';
import '../styles/blog.css';
import { localizedPath, type Locale } from '../i18n/routes';
interface Props {
  title: string; description: string; locale?: Locale; image?: string;
  publishedAt?: string; type?: 'website' | 'article';
}
const { title, description, locale = 'en', image, publishedAt, type = 'website' } = Astro.props;
const origin = 'https://onecodesite.vercel.app';
const pageUrl = new URL(Astro.url.pathname, origin).href;
const imageUrl = image ? new URL(image, origin).href : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#080910" />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={new URL(localizedPath(Astro.url.pathname, 'en'), origin).href} />
    <link rel="alternate" hreflang="es" href={new URL(localizedPath(Astro.url.pathname, 'es'), origin).href} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {publishedAt && <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
  </head>
  <body class="blog-body"><BlogChrome locale={locale}><slot /></BlogChrome><PortfolioChatbot locale={locale} /><PortfolioMusic locale={locale} /></body>
</html>
