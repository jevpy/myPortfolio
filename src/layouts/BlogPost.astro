---
import BlogLayout from './BlogLayout.astro';
import { localeFromLang, localizedPath } from '../i18n/routes';
import { postSummaries } from '../i18n/content';
import { blogCopy, blogDate } from '../i18n/blog';
const { frontmatter } = Astro.props;
const locale = localeFromLang(frontmatter.locale ?? 'en');
const filename = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';
const description = frontmatter.description || postSummaries[locale][filename] || '';
const t = blogCopy[locale];
---
<BlogLayout locale={locale} title={frontmatter.title} description={description} image={frontmatter.image} publishedAt={frontmatter.date} type="article">
  <article class="blog-detail">
    <div class="blog-detail-meta">
      <a class="blog-back" href={localizedPath('/blog', locale)}><span aria-hidden="true">←</span> {t.back}</a>
      <p class="blog-meta">{t.published} <time datetime={frontmatter.date}>{blogDate(frontmatter.date, locale)}</time></p>
    </div>
    <!-- The preserved Markdown body owns the only H1 and its original heading IDs. -->
    <div class="blog-prose"><slot /></div>
    <nav class="blog-detail-end" aria-label={t.back}>
      <a class="blog-back" href={localizedPath('/blog', locale)}><span aria-hidden="true">←</span> {t.back}</a>
    </nav>
  </article>
</BlogLayout>
