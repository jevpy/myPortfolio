---
import type { Locale } from '../i18n/routes';
import { musicCopy, musicTracks } from '../scripts/portfolio-music.mjs';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = musicCopy[locale];
---
<div class="portfolio-music" data-portfolio-music data-locale={locale}>
  <button type="button" data-music-button aria-label={copy.play} aria-pressed="false" title={copy.play}>
    <svg class="music-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m8 5 11 7-11 7z" /></svg>
    <svg class="music-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
    <span data-music-label>{copy.off}</span>
  </button>
  <button type="button" class="music-more" data-music-more aria-expanded="false" aria-controls="music-settings" aria-label={copy.settings} title={copy.settings}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" /></svg>
  </button>
  <div class="music-settings" id="music-settings" data-music-settings>
  <button type="button" class="music-mute" data-music-mute aria-label={copy.mute} aria-pressed="false" title={copy.mute}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 9v6h4l5 4V5L7 9H3zm13-2v2a4 4 0 0 1 0 6v2a6 6 0 0 0 0-10z" /><path class="music-muted-mark" d="m16 8 6 8m0-8-6 8" /></svg>
  </button>
  <label class="music-volume">
    <span class="music-status">{copy.volume}</span>
    <input data-music-volume type="range" min="0" max="100" step="1" value="70" aria-label={copy.volume} aria-valuetext="70%" />
  </label>
  <span class="music-value" data-music-value aria-hidden="true">70%</span>
  <select class="music-track" data-music-track aria-label={copy.track} title={copy.track}>
    {musicTracks.map(item => <option value={item.id}>{item.title}</option>)}
  </select>
  </div>
  <span class="music-status" data-music-status role="status" aria-live="polite" aria-atomic="true"></span>
</div>
<script>
  import { createMusicController } from '../scripts/portfolio-music.mjs';
  const root = document.querySelector('[data-portfolio-music]');
  createMusicController({ root, autostart: true });
  // Phones show a pill; the toggle opens volume and track choice. Desktop keeps everything visible.
  const more = root?.querySelector('[data-music-more]');
  const setOpen = open => { root.classList.toggle('is-open', open); more.setAttribute('aria-expanded', String(open)); };
  more?.addEventListener('click', () => setOpen(more.getAttribute('aria-expanded') !== 'true'));
  root?.addEventListener('keydown', event => { if (event.key === 'Escape' && more.getAttribute('aria-expanded') === 'true') { setOpen(false); more.focus(); } });
  document.addEventListener('pointerdown', event => { if (more?.getAttribute('aria-expanded') === 'true' && !root.contains(event.target)) setOpen(false); });
</script>
<style>
  .portfolio-music { position: fixed; z-index: 19; left: max(16px, env(safe-area-inset-left)); bottom: max(20px, env(safe-area-inset-bottom)); display: flex; flex-wrap: wrap; align-items: center; gap: 2px; width: 288px; max-width: calc(100vw - 104px); box-sizing: border-box; padding: 2px 6px 2px 2px; border: 1px solid #807499; border-radius: 24px; background: #1c1a25; color: #e6ddff; font-size: 12px; }
  .portfolio-music button { display: flex; align-items: center; justify-content: center; gap: 4px; flex-shrink: 0; min-width: 44px; min-height: 44px; padding: 8px; border: 0; border-radius: 24px; background: transparent; color: inherit; font: inherit; line-height: 1.3; cursor: pointer; transition: background-color 150ms ease; }
  .portfolio-music button:hover { background: #353044; }
  .portfolio-music button:focus-visible, .portfolio-music input:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 2px; }
  .portfolio-music svg { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; }
  .music-volume { display: flex; align-items: center; flex: 1; min-width: 0; min-height: 44px; }
  .music-volume input { width: 100%; min-width: 0; height: 44px; margin: 0; accent-color: #c4b5fd; cursor: pointer; }
  .music-value { width: 4ch; flex-shrink: 0; text-align: right; font-variant-numeric: tabular-nums; }
  .music-track { flex: 1 0 calc(100% - 8px); min-width: 0; box-sizing: border-box; min-height: 44px; margin: 0 0 2px 4px; padding: 0 8px; border: 1px solid #807499; border-radius: 22px; background: #1c1a25; color: inherit; font: inherit; cursor: pointer; }
  .music-track:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 2px; }
  .music-pause, .music-muted-mark { display: none; }
  [aria-pressed="true"] .music-play { display: none; }
  [aria-pressed="true"] .music-pause { display: block; }
  [aria-pressed="true"] .music-muted-mark { display: block; stroke: currentColor; stroke-width: 2; fill: none; }
  .music-status { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .portfolio-music .music-more { display: none; }
  .music-more svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .music-more circle { fill: #1c1a25; }
  .music-settings { display: contents; }
  @media (max-width: 640px) {
    .portfolio-music { width: auto; max-width: calc(100vw - 32px); flex-wrap: nowrap; padding: 2px; }
    .portfolio-music .music-more { display: flex; }
    .music-more[aria-expanded="true"] { background: #353044; }
    .portfolio-music .music-mute { display: none; }
    .music-settings { display: none; }
    /* Open: a full-width sheet above the chat launcher row so the two never overlap. */
    .portfolio-music.is-open { flex-wrap: wrap; width: calc(100vw - 32px); bottom: max(76px, calc(env(safe-area-inset-bottom) + 68px)); padding: 2px 6px 2px 2px; }
    .portfolio-music.is-open .music-settings { display: flex; flex-wrap: wrap; align-items: center; flex: 1 0 100%; gap: 2px; }
    .portfolio-music.is-open .music-mute { display: flex; }
    .portfolio-music.is-open .music-more { margin-left: auto; }
  }
  @media (max-width: 400px) { [data-music-label] { display: none; } }
  @media (prefers-reduced-motion: reduce) { .portfolio-music button { transition: none; } }
</style>
