<script is:inline>
  const buttonsound = document.querySelector(".button-sound");
  const audio = document.getElementById("audio");
  const musicOn = document.querySelectorAll(".button-music svg")[0];
  const musicOff = document.querySelectorAll(".button-music svg")[1];
  const pathname = window.location.pathname;

  document.addEventListener("DOMContentLoaded", () => {
    if (pathname !== "/") {
      audio.volume = 0.75;
      let click = 0;
      buttonsound.addEventListener("click", () => {
        click++;
        if (click % 2 !== 0) {
          audio.play();
          musicOn.classList.toggle("hidden");
          musicOff.classList.toggle("hidden");
        } else {
          audio.pause();
          musicOn.classList.toggle("hidden");
          musicOff.classList.toggle("hidden");
        }
      });
    }
  });

