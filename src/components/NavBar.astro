---
const currentPath = Astro.url.pathname;

const post = currentPath.split("/")[1];
---

<style>
  .menu,
  .social {
    display: flex;
    justify-content: space-around;
    margin: 0 auto;
    text-align: center;
    width: 200px;
  }

  .social {
    width: 150px;
    margin: 0 auto;
  }

  .menu {
    width: 200px;
    padding: 1rem 0.5rem 0.5rem;
    border: thin solid #4e4e4e;
    border-radius: 10rem;
    border-radius: 0.5rem;
    margin-top: 1rem;
    background-image: linear-gradient(
      to right top,
      #1b0a32,
      #1c082b,
      #1c0624,
      #1b051e,
      #180418
    );
    background-image: none;
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(0px);
  }

  .menu p {
    background-color: #53086bff;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    color: #caa0fcff;
    color: #e6d3ffff;
  }

  .menu a,
  .menu .button-sound {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .menu a:hover small,
  .menu .button-sound:hover small {
    display: block;
    transition: display 0.3s ease-in-out;
  }

  .menu small {
    color: rgb(231, 225, 238);
    display: none;
    position: absolute;
    bottom: 1.9rem;
  }

  .menu a.active::after {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-top: 2px;
    background-color: rgb(198, 83, 243);
  }

  .social {
    margin-top: 1rem;
  }

  .social a {
    transition: transform 0.2s ease;
  }

  .social a:hover {
    transform: scale(1.2);
  }

  .button-sound {
    cursor: pointer;
  }
</style>

<nav>
  <div class="menu">
    <a href="/" class={currentPath === "/" ? "active" : ""}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        color="currentColor"
        fill="none">
        <path
          d="M15.0001 17C14.2006 17.6224 13.1504 18 12.0001 18C10.8499 18 9.79965 17.6224 9.00012 17"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
        <path
          d="M2.35151 13.2135C1.99849 10.9162 1.82198 9.76763 2.25629 8.74938C2.69059 7.73112 3.65415 7.03443 5.58126 5.64106L7.02111 4.6C9.41841 2.86667 10.6171 2 12.0001 2C13.3832 2 14.5818 2.86667 16.9791 4.6L18.419 5.64106C20.3461 7.03443 21.3097 7.73112 21.744 8.74938C22.1783 9.76763 22.0018 10.9162 21.6487 13.2135L21.3477 15.1724C20.8473 18.4289 20.597 20.0572 19.4291 21.0286C18.2612 22 16.5538 22 13.1389 22H10.8613C7.44646 22 5.73903 22 4.57112 21.0286C3.40321 20.0572 3.15299 18.4289 2.65255 15.1724L2.35151 13.2135Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
      </svg>
      <small>Home</small>
    </a>
    <a href="/directory" class={currentPath === "/directory" ? "active" : ""}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        color="currentColor"
        fill="none">
        <path
          d="M6.57757 15.4816C5.1628 16.324 1.45336 18.0441 3.71266 20.1966C4.81631 21.248 6.04549 22 7.59087 22H16.4091C17.9545 22 19.1837 21.248 20.2873 20.1966C22.5466 18.0441 18.8372 16.324 17.4224 15.4816C14.1048 13.5061 9.89519 13.5061 6.57757 15.4816Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M16.5 6.5C16.5 8.98528 14.4853 11 12 11C9.51472 11 7.5 8.98528 7.5 6.5C7.5 4.01472 9.51472 2 12 2C14.4853 2 16.5 4.01472 16.5 6.5Z"
          stroke="currentColor"
          stroke-width="1.5"></path>
      </svg>
      <small>Tools/Ai</small>
    </a>
    <a
      href="/blog"
      class={currentPath === "/blog" || post === "posts" ? "active" : ""}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        color="currentColor"
        fill="none">
        <path
          d="M12 6L12 20"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
        <path
          d="M5.98056 3.28544C9.32175 3.9216 11.3131 5.25231 12 6.01628C12.6869 5.25231 14.6782 3.9216 18.0194 3.28544C19.7121 2.96315 20.5584 2.80201 21.2792 3.41964C22 4.03727 22 5.04022 22 7.04612V14.255C22 16.0891 22 17.0061 21.5374 17.5787C21.0748 18.1512 20.0564 18.3451 18.0194 18.733C16.2037 19.0787 14.7866 19.6295 13.7608 20.1831C12.7516 20.7277 12.247 21 12 21C11.753 21 11.2484 20.7277 10.2392 20.1831C9.21344 19.6295 7.79633 19.0787 5.98056 18.733C3.94365 18.3451 2.9252 18.1512 2.4626 17.5787C2 17.0061 2 16.0891 2 14.255V7.04612C2 5.04022 2 4.03727 2.72078 3.41964C3.44157 2.80201 4.2879 2.96315 5.98056 3.28544Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <small>Blog</small>
    </a>
  </div>
</nav>
