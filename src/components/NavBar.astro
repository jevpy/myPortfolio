---
const currentPath = Astro.url.pathname;

const post = currentPath.split("/")[1];
---

<style>
  .menu,
  .social {
    display: flex;
    justify-content: space-around;
    margin: 0 auto;
    text-align: center;
    width: 200px;
  }

  .social{
    width: 150px;
    margin: 0 auto;
  }

  .menu {
    width: 200px;
    padding: 0.75rem 0.5rem 0.25rem;
    border: thin solid #4e4e4e;
    border-radius: 10rem;
    border-radius: 0.5rem;

    background-image: linear-gradient(
      to right top,
      #1b0a32,
      #1c082b,
      #1c0624,
      #1b051e,
      #180418
    );
    background-image: none;
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(0px);
  }

  .menu p {
    background-color: #53086bff;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    color: #caa0fcff;
    color: #e6d3ffff;
  }

  .menu a,
  .menu .button-sound {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .menu a:hover small,
  .menu .button-sound:hover small {
    display: block;
    transition: display 0.3s ease-in-out;
  }

  .menu small {
    color: rgb(231, 225, 238);
    display: none;
    position: absolute;
    bottom: 1.9rem;
  }

  .menu a.active::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-top: 2px;
    background-color: rgb(198, 83, 243);
  }

  .social {
    margin-top: 1rem;
  }

  .social a {
    transition: transform 0.2s ease;
  }

  .social a:hover {
    transform: scale(1.2);
  }

  .button-sound {
    cursor: pointer;
  }
</style>

