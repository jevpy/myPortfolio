---
import CodeDescription from "./CodeDescription.astro";
import { AuroraBackground } from "./ui/aurora-background";
import { Spotlight } from "./ui/spotlight";
---

<style>
  @keyframes vibrate-1 {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.5rem);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes pulsate-bck {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
      background-color: rgb(139, 248, 172);
    }
  }

  div {
    /* background-color: #8907f0ff; */
    /* background-color: #6900ffff; */
    /* background-color: #4f00ff; */
    /* background-color: #8f00ffff; */
  }

  .avaliable {
    padding: 0.25rem 0.5rem;
    border: thin solid rgb(74, 233, 122);
    border-radius: 1rem;
    background-color: rgba(46, 125, 70, 0.5);
    color: rgb(167, 237, 186);
  }

  .avaliable::before {
    display: inline-block;
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgb(74, 233, 122);
    margin-right: 5px;
    animation: pulsate-bck 1.5s ease-in-out infinite both;
  }

  .user {
    display: flex;
    gap: 10px;
  }

  .img {
    width: 50px;
    height: 50px;
    font-size: 25px;
    font-weight: 700;
    border: 1px solid #1877f2;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }

  .name {
    font-size: 17px;
    font-weight: 700;
    color: #1877f2;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 0;
    color: #fff;
  }

  .about {
    color: #ccc;
    padding-top: 5px;
  }

  img {
    /* filter: drop-shadow(-2px -3px 70px rgb(174, 0, 255)); */
    filter: drop-shadow(-2px -3px 250px #9914d8ff);
  }

  .vibrate-1 {
    animation: vibrate-1 3s linear infinite both;
  }

  .social-media a:hover {
    border-radius: 50%;
    transform: scale(0.9);
    animation:
      border-radius,
      5s transform 0.5s;
  }
</style>

